#!/bin/bash
# Diagnose a crash with a chosen agent, not just the default one.
#
# Usage: crashdesk-agent <agent> <pid> [comm] [exe] [signal]
#
# `omarchy-agent-crash` always launches the default agent, and `omarchy-agent`
# has no way to name another. This keeps the same prompt and the same launch
# flags per agent (copied from omarchy-agent, Omarchy 4.0.4) so a picked agent
# starts exactly as the default one would. When upstream gains
# `omarchy-agent --agent`, this file goes away.
set -euo pipefail

agent=${1:?usage: crashdesk-agent <agent> <pid> [comm] [exe] [signal]}
pid=${2:?usage: crashdesk-agent <agent> <pid> [comm] [exe] [signal]}
[[ $pid =~ ^[0-9]+$ ]] || { echo "Not a PID: $pid" >&2; exit 1; }
[[ $agent =~ ^[a-z][a-z0-9-]*$ ]] || { echo "Not an agent name: $agent" >&2; exit 1; }
comm=${3:-unknown}
exe=${4:-unknown}
signal=${5:-unknown}

if ! command -v "$agent" >/dev/null 2>&1 && [[ $agent != openclaw ]]; then
  echo "$agent is not installed" >&2
  exit 1
fi

skill="${OMARCHY_PATH:-/usr/share/omarchy}/default/agents/skills/diagnose-crash/SKILL.md"
when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

# The same words omarchy-agent-crash uses, so every agent gets the same brief.
prompt=$(
  cat <<PROMPT
A process crashed on this Omarchy machine and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     $when

Use the diagnose-crash skill: it covers how to investigate, what to report, and
when a crash is worth reporting upstream to Omarchy. If your harness has no skill
mechanism, read the skill files directly and follow them instead:
  $skill
PROMPT
)

[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

case "$agent" in
opencode)      command=(opencode --auto --prompt "$prompt") ;;
gemini)        command=(gemini --yolo --prompt-interactive "$prompt") ;;
copilot)       command=(copilot --allow-all --interactive "$prompt") ;;
crush)         command=(crush run "$prompt") ;;
claude)        command=(claude --permission-mode auto -- "$prompt") ;;
grok)          command=(grok --permission-mode bypassPermissions -- "$prompt") ;;
openclaw)      command=(omarchy-launch-openclaw --tui --message "$prompt") ;;
codex)         command=(codex --approve-for-me -- "$prompt") ;;
cursor-agent)  command=(cursor-agent --yolo --trust agent -- "$prompt") ;;
hermes)        command=(env -u HERMES_SESSION_SOURCE hermes chat --yolo --tui "--query=$prompt") ;;
muse)          command=(muse --approval-mode never -- "$prompt") ;;
omp)           command=(omp --auto-approve -- "$prompt") ;;
pi)            command=(pi "$prompt") ;;
*) echo "Unsupported agent: $agent" >&2; exit 1 ;;
esac

exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
